# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ielts_ai_mastery

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI provider: openai | anthropic | ollama
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OCR — scanned / image-based PDF fallback (pytesseract + Pillow).
# Requires the tesseract binary: macOS  ->  brew install tesseract
OCR_ENABLED=true
OCR_DPI=200
OCR_MIN_CHARS_PER_PAGE=80
OCR_LANGUAGE=eng
# Soft page cap. Empty or 0 uses MAX_PDF_PAGES. It is never unlimited.
OCR_MAX_PAGES=

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000

# Route prefix. Empty for local dev (http://localhost:8010/auth/...).
# Production behind https://your-domain/api: API_ROOT_PREFIX=/api
API_ROOT_PREFIX=

# Amazon S3 — primary store for original/binary files.
# When these are set, originals go to S3 and Mongo keeps only the object key.
# When unset, local development stores files under UPLOAD_DIR. Production
# (public CORS origin, API_ROOT_PREFIX, or APP_ENV=production) refuses uploads
# instead of writing them to container disk.
# Downloads are presigned. AWS_S3_PUBLIC_BASE_URL is ignored.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PUBLIC_BASE_URL=
S3_PRESIGN_EXPIRY=3600

# Caps. Registration stays open; these stop one account from draining AI and storage.
MAX_UPLOAD_BYTES=26214400
MAX_PASTE_CHARS=500000
MAX_PDF_PAGES=80
MAX_URL_BYTES=1500000
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=900
MAX_SOURCES_PER_USER=200
MAX_STORAGE_BYTES_PER_USER=524288000
MAX_ACTIVE_JOBS_PER_USER=3
MAX_AI_CALLS_PER_DAY=40
RATE_REGISTER_PER_HOUR=8
RATE_LOGIN_PER_HOUR=20
RATE_IMPORT_PER_HOUR=30
